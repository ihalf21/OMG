{
  "name": "oh-my-gantt",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "playwright-core": "^1.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^8.2.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "client": "react-scripts start",
    "server": "node server/index.js",
    "build": "react-scripts build",
    "db:migrate": "node -e \"const db=require('./server/db'); const d=db.getAllData(); console.log(JSON.stringify({sqlitePath:db.SQLITE_PATH, projects:d.projects.length, users:d.users.length, members:d.projectMembers.length}, null, 2))\"",
    "db:backup": "node server/backup-db.js",
    "test": "npm run test:client && npm run test:server",
    "test:client": "react-scripts test --watchAll=false",
    "test:server": "node --test server/*.test.js",
    "test:watch": "react-scripts test"
  },
  "proxy": "http://localhost:3001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
